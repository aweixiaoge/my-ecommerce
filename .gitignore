.next/
out/
dist/
build/

# Prisma's generated client. It is written into the package's source tree
# because the `prisma-client` generator emits TypeScript rather than a built
# package, and it is machine-written code that `db:generate` reproduces — the
# package's `postinstall` runs it, so a clone gets one without being told.
packages/db/src/generated/
coverage/
.turbo/
.vercel/
.claude/worktrees/
.env
.env.local
.env.*.local

*.log
.DS_Store

# Playwright MCP scratch output (page snapshots, console logs, screenshots)
.playwright-mcp/
# Root-level screenshots only — NOT *.png, which would silently swallow real
# image assets added under apps/web/public.
/*.png

# tdd-guardian generated artifacts
.claude/tdd-guardian/state.json
.claude/tdd-guardian/receipts.json
