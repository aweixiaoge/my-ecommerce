// The catalogue, as `docs/plan.md` describes it.
//
// Two things about the shape are decisions rather than defaults:
//
//   * Every user-facing text field lives in a `(entity_id, locale)` side table
//     (decision 1). Nothing here holds an English string in a column of its
//     own, so adding a language is inserting rows rather than migrating a
//     table. That is why a product is not one row and creating one is a
//     transaction.
//   * Money is a `Decimal` and a currency code (decision 3), never a float and
//     never a bare number. `price_currency` sits next to `price_amount` so the
//     row means something on its own.
//
// Deliberately absent: `media_translations` and every table from Phase 2
// onwards except the cart's two, the order's four and the account's three,
// which arrived with the "Add to cart" buttons, the checkout and the My account
// page that write them. The rest arrive with
// the screens that write them; a table nothing can populate is a table that
// has to be kept migrated for no reason.
//
// `reviews` is the one table here that plan.md files under a later phase
// (Phase 5) — it arrived with the product page's review section. Two of that
// phase's tables are still not here: `review_media`, because the design's form
// has no upload box and a table nothing can populate is the rule above, and
// `product_review_stats`, because the rating a card shows is computed live
// from the approved rows (`groupBy`) rather than denormalised — one source of
// truth that cannot be forgotten by a write path. Both are deliberate, and
// both are reversible additions rather than migrations of what is below.

generator client {
  provider = "prisma-client"
  // Generated into the package's source tree rather than node_modules. The
  // `prisma-client` generator emits TypeScript, and `apps/web` transpiles it
  // through the workspace the same way it does `@my-ecommerce/shared`.
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  draft
  active
  archived
}

/// Whether a review is on the product page or waiting to be.
///
/// `pending` is a state rather than an absence, which is the point: the
/// moderation screen's queue is a query for it, and a review with no status
/// would be a row nothing could ask for. plan.md spells the three words; they
/// are lowercase members of a quoted PascalCase type, the shape `ProductStatus`
/// already has.
enum ReviewStatus {
  pending
  approved
  rejected
}

/// What an option *is*, as opposed to what it is called.
///
/// plan.md's first decision is that a kind is stored and its name is a
/// translation of it — "Color" is English for `color`, and a second language
/// would not change the column. Without this the only record of what an option
/// is is the English word in its translation row, which means the admin cannot
/// offer to add an option without reading English back out of the database, and
/// "one option per kind" becomes a rule about a string rather than about the
/// thing.
enum AttributeKind {
  color
  size
}

model Product {
  id        String        @id @default(cuid())
  status    ProductStatus @default(draft)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  translations    ProductTranslation[]
  options         ProductOption[]
  variants        ProductVariant[]
  media           Media[]
  categories      ProductCategory[]
  reviews         Review[]
  featuredProduct FeaturedProduct?
  coupons         CouponProduct[]

  @@map("products")
}

/// Name, slug and copy, one row per language. The slug lives here rather than
/// on `products` because German pages get German URLs (decision 2), and it is
/// unique within a locale rather than globally.
model ProductTranslation {
  id              String  @id @default(cuid())
  productId       String  @map("product_id")
  locale          String
  /// Who wrote this row. `false` is a person — what every screen writes, and
  /// what every row written before machine translation existed is — and `true`
  /// is the translation pass (`lib/admin/translations.ts`). Only machine rows
  /// are ever refreshed, which is what lets somebody correct a translation by
  /// hand without the next English edit overwriting it.
  autoTranslated  Boolean @default(false) @map("auto_translated")
  name            String
  slug            String
  description     String  @default("")
  /// The one-line blurb cards and listings show. The plan's column list says
  /// "key columns" rather than all of them, and the storefront's own
  /// `ProductSchema` carries this field — so it belongs here rather than in a
  /// column of its own on `products`, which would be an English string outside
  /// the translation tables.
  shortDescription String @default("") @map("short_description")
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@map("product_translations")
}

/// "Colour", "Size". `position` is the order they are offered in, which is the
/// order the person typed them.
model ProductOption {
  id        String        @id @default(cuid())
  productId String        @map("product_id")
  kind      AttributeKind
  position  Int

  product      Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations ProductOptionTranslation[]
  values       ProductOptionValue[]

  @@index([productId])
  @@map("product_options")
}

model ProductOptionTranslation {
  id       String @id @default(cuid())
  optionId String @map("option_id")
  locale   String
  /// Who wrote this row. `false` is a person — what every screen writes, and
  /// what every row written before machine translation existed is — and `true`
  /// is the translation pass (`lib/admin/translations.ts`). Only machine rows
  /// are ever refreshed, which is what lets somebody correct a translation by
  /// hand without the next English edit overwriting it.
  autoTranslated  Boolean @default(false) @map("auto_translated")
  name     String

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
  @@map("product_option_translations")
}

/// "Black", "Sand".
model ProductOptionValue {
  id       String @id @default(cuid())
  optionId String @map("option_id")
  position Int

  option       ProductOption                   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  translations ProductOptionValueTranslation[]
  variants     VariantOptionValue[]
  cartItems    CartItem[]

  @@index([optionId])
  @@map("product_option_values")
}

model ProductOptionValueTranslation {
  id      String @id @default(cuid())
  valueId String @map("value_id")
  locale  String
  /// Who wrote this row. `false` is a person — what every screen writes, and
  /// what every row written before machine translation existed is — and `true`
  /// is the translation pass (`lib/admin/translations.ts`). Only machine rows
  /// are ever refreshed, which is what lets somebody correct a translation by
  /// hand without the next English edit overwriting it.
  autoTranslated  Boolean @default(false) @map("auto_translated")
  name    String

  value ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([valueId, locale])
  @@map("product_option_value_translations")
}

/// What a product is actually sold as.
///
/// Three columns are nullable, and all three for the same reason: the admin
/// form creates DRAFTS, and a colour added a minute ago has no SKU, no price
/// and nobody to decide them yet. Fabricating values to keep the columns
/// non-null would put numbers in the catalogue that no one typed. `sku` and
/// the price pair become required when a product is activated, which is a rule
/// for the code that activates one.
///
/// `weight` is the plan's column and nothing writes it yet — nullable, so the
/// table matches the plan rather than needing a migration the first time
/// shipping rates want it.
model ProductVariant {
  id            String        @id @default(cuid())
  productId     String        @map("product_id")
  sku           String?       @unique
  priceAmount   Decimal?      @map("price_amount") @db.Decimal(10, 2)
  priceCurrency String?       @map("price_currency") @db.Char(3)
  stock         Int           @default(0)
  weight        Decimal?      @db.Decimal(10, 3)
  status        ProductStatus @default(draft)

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  media        Media[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

/// Which option values select a variant. Colour × Size makes one variant per
/// pair, and this is the table that says which pair.
model VariantOptionValue {
  variantId     String @map("variant_id")
  optionValueId String @map("option_value_id")

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

/// An image.
///
/// Two columns beyond the plan's `id, product_id, variant_id, url, position`,
/// and both are because there is no object storage to put a file in: `data`
/// holds the bytes and `mime_type` says what they are, so the route handler can
/// serve them back with a content type it chose rather than one the upload
/// claimed. When a bucket exists, the bytes move out and `url` is what is left.
///
/// Every owner link is nullable, and that is not laziness: an image is uploaded
/// while the form is still being filled in, so there is no product, no variant
/// and no post to attach it to yet. The create action claims them by id. Which
/// of the three a row carries is the form's business — the product form gives
/// its images to variants, the blog form to the post itself — and position is
/// the order within that owner, with zero being the Main image.
///
/// `about_page` is the fourth owner, a flag rather than a key: the About page is
/// one page with no row of its own to point at (its words are in
/// `about_translations`, one row per language). Saving the About screen claims
/// its images by setting it and deletes the ones taken off.
model Media {
  id        String  @id @default(cuid())
  productId String? @map("product_id")
  variantId String? @map("variant_id")
  blogId    String? @map("blog_id")
  aboutPage Boolean @default(false) @map("about_page")
  url       String
  position  Int     @default(0)

  data     Bytes?
  mimeType String? @map("mime_type")

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  blog    Blog?           @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([blogId])
  @@index([aboutPage])
  @@map("media")
}

/// The category tree.
///
/// plan.md lists three columns; the timestamp pair is what the root tables
/// carry — `products` has it, and a category is a root the same way — and
/// `created_at` is what gives a list of rows whose `position` is all zero —
/// every category the create screen can make — an order that does not shuffle
/// between reads.
///
/// `parent_id` and `position` are the tree's, and they are here because they
/// are what the table *is*: the create screen writes only a name, so every row
/// it makes is a root at position zero, and the tree screen writes the rest.
/// The cascade is the file's convention for every relation, and it is also the
/// only sensible one for a tree — a child whose parent is gone is not a
/// category at the top level, it is an orphan. The one deliberate exception is
/// `blogs.category_id`, which unfiles a post rather than deleting it; it says
/// so where it is written.
model Category {
  id        String   @id @default(cuid())
  parentId  String?  @map("parent_id")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

/// Name, slug and copy, one row per language — the shape of a product's
/// translation, for the same two decisions: text lives in `(entity_id, locale)`
/// tables (decision 1), and the slug lives with it, unique within a locale
/// rather than globally (decision 2).
///
/// `description` defaults to empty because the create screen has no box for it:
/// a category made with a name alone is finished, not half-written. A column
/// nothing fills is still the plan's column, and the screen that edits copy
/// will find it rather than migrate for it.
model CategoryTranslation {
  id              String  @id @default(cuid())
  categoryId      String  @map("category_id")
  locale          String
  /// Who wrote this row. `false` is a person — what every screen writes, and
  /// what every row written before machine translation existed is — and `true`
  /// is the translation pass (`lib/admin/translations.ts`). Only machine rows
  /// are ever refreshed, which is what lets somebody correct a translation by
  /// hand without the next English edit overwriting it.
  autoTranslated  Boolean @default(false) @map("auto_translated")
  name            String
  slug            String
  description     String  @default("")
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

/// Which categories a product is listed in.
///
/// A join table rather than a `category_id` column on `products`, because the
/// plan's catalogue has a product in more than one category — and the first
/// time that is true, a column would have to be migrated into this shape. The
/// admin's form offers a single choice today; the table does not narrow because
/// of it.
///
/// Both sides cascade, like every other relation here: taking a category away
/// takes it off the products it described rather than leaving a row pointing at
/// nothing. `@@index([categoryId])` is the direction the primary key does not
/// already cover — a category's products, rather than a product's categories.
model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

/// A review somebody wrote, and whether anyone has let it through.
///
/// plan.md's column list is `id, product_id, customer_id, order_item_id,
/// rating, title, body, locale, status, created_at`. Two of those are
/// deliberately not built, for the same reason twice:
///
///   * `customer_id` and `order_item_id` point at `customers` and `orders`,
///     neither of which exists — `order_item_id` is how a review becomes a
///     verified purchase, and a verified purchase cannot be built before the
///     thing it verifies. `author_name` and `author_email` stand in their
///     place, because the design's form asks a guest for both and a review
///     with nobody's name on it is not a review. They are also what a backfill
///     from real accounts would key on, so the migration when accounts arrive
///     is an UPDATE rather than a reshape.
///   * `title` is *kept* and left nullable, the way `ProductVariant.weight` is:
///     the plan lists the column, the design's form has no box for it, and a
///     nullable column costs nothing where a migration costs a deploy. Nothing
///     writes it, so nothing reads it — the shared contract has no `title`
///     either.
///
/// `status` defaults to `pending` here rather than in the insert, so a row put
/// in by hand gets the same treatment as one the storefront's form wrote.
/// Nothing approves its own writing.
///
/// `locale` is the language it was written in — a plain column, not a
/// `review_translations` table, because reviews are user content and are not
/// translated (plan.md). The point of a review is that nobody rewrites what
/// somebody said.
///
/// `created_at` alone: the plan lists no `updated_at` and nothing reads one.
/// "Approved at, by whom" belongs in the audit log plan.md specifies, not as a
/// second bare column here.
///
/// `author_email` is private. It is collected so a moderator can see who wrote
/// something, the admin list is the only read that selects it, and it is never
/// rendered.
model Review {
  id          String       @id @default(cuid())
  productId   String       @map("product_id")
  authorName  String       @map("author_name")
  authorEmail String       @map("author_email")
  rating      Int
  title       String?
  body        String
  locale      String
  status      ReviewStatus @default(pending)
  createdAt   DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// `(product_id, status)`, in that order, and it is the only index here
  /// because it is the only shape anything asks for: both storefront reads hit
  /// it — the approved list filters on exactly this pair, and the rating
  /// aggregate groups by `product_id` while filtering `status`. The admin's
  /// list is neither filtered nor ordered by these columns, so an index for it
  /// would be an index for a query nobody has written yet.
  @@index([productId, status])
  @@map("reviews")
}

/// Which products the home page features.
///
/// The product id is the whole key, like the pair on `product_categories` and
/// for the same kind of reason: featuring a product twice is the same row
/// rather than a duplicate — nothing here expresses why a product would appear
/// twice — and a primary key is what makes the write an idempotent insert
/// rather than a read followed by a decision.
///
/// No `position`, deliberately, although `categories` carries one. There the
/// column is the order a tree screen will offer siblings in; here `created_at`
/// alone is a complete order — the order things were featured in — and a
/// position nothing writes would be a second order contradicting the first. A
/// screen that lets someone drag this list into a different one brings the
/// column with it.
///
/// The admin picks the set (`/admin/features`); the storefront's hero shows the
/// newest row that is a product the shop can actually sell — see
/// `lib/catalog/featured-repo.ts`.
model FeaturedProduct {
  productId String   @id @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("featured_products")
}

/// A blog post, and the category it is filed under.
///
/// The category is a column rather than the join table `product_categories` is,
/// and the difference is a fact about the content: a post carries one category —
/// the admin's form offers one and the storefront's listing view draws one label
/// — where the plan's catalogue puts a product in more than one. A post that
/// belongs to several is a migration into that shape, the same way the join
/// table would have been.
///
/// `SetNull` is the file's one exception to cascading, and it is the point: the
/// convention would delete every post filed under a category the moment that
/// category went away. Unfiling them destroys nothing, and Prisma only permits
/// it on a nullable foreign key — so the column is optional even though the
/// create form requires a choice, the same form-versus-database asymmetry
/// `products` already carries for its own category.
///
/// plan.md's Content table also lists `status`, `author_id`, `published_at` and
/// `cover_media_id`. None of the four is here yet: the first three arrive with
/// the screens that write them, and the cover is not a column at all — it is the
/// first of the post's images, the way a product's Main image is position zero.
model Blog {
  id         String   @id @default(cuid())
  categoryId String?  @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  translations BlogTranslation[]
  category     BlogCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media        Media[]

  @@index([categoryId])
  @@map("blogs")
}

/// Title, slug and copy, one row per language — a product's translation with the
/// storefront's name for the blurb: its listing view calls the field `excerpt`,
/// and it is the same one-line text a product card shows as `short_description`.
model BlogTranslation {
  id               String  @id @default(cuid())
  blogId           String  @map("blog_id")
  locale           String
  /// Who wrote this row. `false` is a person — what every screen writes, and
  /// what every row written before machine translation existed is — and `true`
  /// is the translation pass (`lib/admin/translations.ts`). Only machine rows
  /// are ever refreshed, which is what lets somebody correct a translation by
  /// hand without the next English edit overwriting it.
  autoTranslated  Boolean @default(false) @map("auto_translated")
  title            String
  slug             String
  shortDescription String  @default("") @map("short_description")
  description      String  @default("")
  metaTitle        String? @map("meta_title")
  metaDescription  String? @map("meta_description")

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, locale])
  @@unique([locale, slug])
  @@map("blog_translations")
}

/// The blog's categories.
///
/// No `parent_id`, no `position`, unlike `categories` — there the tree is the
/// plan's and the columns are what the table *is*, and here nothing has said a
/// blog category has a parent or an order a screen will one day drag. The
/// timestamp pair is what the list orders by, with the id breaking its ties.
model BlogCategory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations BlogCategoryTranslation[]
  blogs        Blog[]

  @@map("blog_categories")
}

/// Name, slug and copy, one row per language — the shape of a category's
/// translation, for the same two decisions: text lives in `(entity_id, locale)`
/// tables, and the slug lives with it, unique within a locale.
model BlogCategoryTranslation {
  id              String  @id @default(cuid())
  categoryId      String  @map("category_id")
  locale          String
  /// Who wrote this row. `false` is a person — what every screen writes, and
  /// what every row written before machine translation existed is — and `true`
  /// is the translation pass (`lib/admin/translations.ts`). Only machine rows
  /// are ever refreshed, which is what lets somebody correct a translation by
  /// hand without the next English edit overwriting it.
  autoTranslated  Boolean @default(false) @map("auto_translated")
  name            String
  slug            String
  description     String  @default("")
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")

  category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("blog_category_translations")
}

/// What one currency costs in another: units of `quote_currency` per one
/// `base_currency`.
///
/// plan.md files this under the i18n and currency infrastructure and gives it a
/// `source` and a `fetched_at` for the reason the columns are here before the
/// feature is: the rates are meant to come from a provider on a schedule
/// (Phase 9), and a table shaped for that makes the provider a write rather
/// than a migration. Until one is wired, the rows are seed data and `source`
/// says so.
///
/// Keyed on the pair rather than given an id — a rate is a fact about two
/// currencies and there is exactly one of it. The storefront reads the rows
/// quoted from the shop's own currency, which is what lets it convert through a
/// single cross rate with one rounding; see `apps/web/lib/currency/`.
///
/// There is no `currencies` table beside it, which plan.md's schema also names.
/// The code is the whole of what the storefront needs: the symbol, the decimals
/// and the rounding are `Intl`'s and the app's display rule, and a table nothing
/// can populate is a table that has to be kept migrated for no reason.
model ExchangeRate {
  baseCurrency  String   @map("base_currency") @db.Char(3)
  quoteCurrency String   @map("quote_currency") @db.Char(3)
  /// Units of `quote_currency` per one `base_currency`. `Decimal`, never a
  /// float — a rate is multiplied into every price on the page.
  rate          Decimal  @db.Decimal(20, 10)
  /// Who wrote the row: `seed` for the migration's own rows, a provider's name
  /// once one is wired.
  source        String
  fetchedAt     DateTime @map("fetched_at")

  @@id([baseCurrency, quoteCurrency])
  @@map("exchange_rates")
}

/// A shopper's cart: plan.md's list of intent, not a list of prices.
///
/// A guest cart is all there is — customer accounts are Phase 3 — so a cart is
/// found by the token in the shopper's `cart` cookie. The column holds the
/// token's SHA-256 rather than the token, the rule `lib/admin/session-store.ts`
/// follows for admin sessions: a leaked row, backup or log line is then nothing
/// anyone can replay as a cookie.
///
/// Three of plan.md's columns are absent on purpose. `customer_id` has no
/// customers to point at yet. `currency` and `locale` would be snapshots of two
/// preferences the request already carries — the currency cookie and the URL —
/// and every figure in a cart is recomputed on read in the reader's language and
/// currency anyway; checkout is where a currency gets fixed, and it is the order
/// that records it (plan.md's decision 5).
///
/// `expires_at` slides forward on every write. Nothing sweeps expired rows yet:
/// a read treats one as absent and the next add replaces it.
model Cart {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@map("carts")
}

/// One variant in a cart, and how many of it.
///
/// No price column, and that is the design rather than an omission: the price
/// is read from the variant every time the cart is, so a price change in the
/// admin reaches every open cart and a tampered form has nothing to tamper with.
///
/// `option_value_id` is the shopper's pick from an option no variant stands
/// behind — today, Size. The admin writes one variant per colour, so a size is
/// a choice the catalogue offers without a variant (or a price, or stock) of
/// its own; without this column the "M" a shopper chose would be lost the
/// moment it reached the cart. Null for a product with no such option.
///
/// Adding the same variant in the same size raises the line's quantity rather
/// than drawing it twice. That is enforced by `lib/cart/cart-repo.ts` rather
/// than the index alone: Postgres treats two nulls as distinct, so the index
/// below does not stop two size-less lines of one variant. Deleting a variant
/// or the size value — which the admin does when an option value is removed —
/// takes its cart lines with it.
model CartItem {
  id            String   @id @default(cuid())
  cartId        String   @map("cart_id")
  variantId     String   @map("variant_id")
  optionValueId String?  @map("option_value_id")
  quantity      Int
  createdAt     DateTime @default(now()) @map("created_at")

  cart        Cart                @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant     ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId, optionValueId])
  @@index([variantId])
  @@index([optionValueId])
  @@map("cart_items")
}

/// plan.md's order state machine. Every state is here because the machine is
/// the plan's, but only `pending` is written yet: checkout places an order,
/// and the transitions out of it are Phase 4's admin and the payment
/// provider's webhook. `pending → paid` comes only from the provider, never
/// from a browser — cash on delivery stays `pending` until it is collected.
enum OrderStatus {
  pending
  paid
  processing
  shipped
  delivered
  failed
  cancelled
  refunded
}

enum AddressKind {
  shipping
  billing
}

/// An order: what was bought, for how much, and where it goes.
///
/// It snapshots everything (plan.md's decision 4). The money is stored, not
/// recomputed — unlike a cart, an order is a record of a price that was
/// agreed — and each line carries the product as it was in `product_snapshot`,
/// so an order renders the same in ten years whatever happens to the catalogue.
///
/// Amounts are in `currency`, the shop's. `display_currency` and
/// `exchange_rate` record what the shopper was reading in and at what rate
/// (decision 5): units of the display currency per one of `currency`, `1` when
/// they are the same.
///
/// `order_number` is the public, human number ("Order #1042"); `id` is never
/// shown. `access_key` is the capability in the confirmation link — Woo's
/// `order_key`. It is stored as it is rather than hashed, because a repeated
/// submission of the same checkout has to be sent back to the same link, and
/// a hash cannot be turned back into one. It opens a read-only page and
/// nothing else.
///
/// `idempotency_key` is minted with the checkout form and sent with it, so a
/// double-click or a retried request finds the order the first one made rather
/// than placing a second.
///
/// `customer_id` is the account that was signed in when the order was placed,
/// and null for a guest. It is the only thing that puts an order in a
/// customer's history: a guest order is never matched to an account by its
/// email, because anyone can open an account with anyone's address. Deleting
/// a customer leaves their orders standing (decision 7), unowned.
///
/// `coupon_code` is the code the order was placed with, copied rather than a
/// key to `coupons`: the order is a record of what was redeemed, and stays
/// right if the coupon is later changed or deleted. Its discount is in
/// `discount_total`.
///
/// Deliberately absent from plan.md's list: the per-line `tax_amount` /
/// `discount_amount` (no tax yet, and a coupon's discount is the order's, not
/// split across its lines).
model Order {
  id              String      @id @default(cuid())
  orderNumber     Int         @unique @default(autoincrement()) @map("order_number")
  accessKey       String      @unique @map("access_key")
  idempotencyKey  String      @unique @map("idempotency_key")
  customerId      String?     @map("customer_id")
  email           String
  status          OrderStatus @default(pending)
  paymentMethod   String      @map("payment_method")
  shippingMethod  String      @map("shipping_method")
  locale          String
  currency        String      @db.Char(3)
  displayCurrency String      @map("display_currency") @db.Char(3)
  exchangeRate    Decimal     @map("exchange_rate") @db.Decimal(20, 10)
  subtotal        Decimal     @db.Decimal(10, 2)
  discountTotal   Decimal     @map("discount_total") @db.Decimal(10, 2)
  couponCode      String?     @map("coupon_code")
  shippingTotal   Decimal     @map("shipping_total") @db.Decimal(10, 2)
  taxTotal        Decimal     @map("tax_total") @db.Decimal(10, 2)
  grandTotal      Decimal     @map("grand_total") @db.Decimal(10, 2)
  note            String?
  paidAt          DateTime?   @map("paid_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  addresses     OrderAddress[]
  statusHistory OrderStatusHistory[]

  @@index([email])
  @@index([customerId, createdAt])
  @@map("orders")
}

/// One line of an order, frozen.
///
/// `variant_id` is kept for reporting and set to null if the variant is ever
/// deleted — the line must survive that, which is what the snapshot is for:
/// `{ productId, name, slug, sku, options: [{ option, value }], imageId }`.
model OrderItem {
  id              String  @id @default(cuid())
  orderId         String  @map("order_id")
  variantId       String? @map("variant_id")
  productSnapshot Json    @map("product_snapshot")
  quantity        Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

/// An order's addresses, copied rather than referenced (plan.md: a
/// denormalised copy). Billing is always written, as a copy of shipping when
/// the shopper said they are the same, so nothing reading an order has to know
/// about that checkbox.
model OrderAddress {
  id          String      @id @default(cuid())
  orderId     String      @map("order_id")
  kind        AddressKind
  firstName   String      @map("first_name")
  lastName    String      @map("last_name")
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String      @map("postal_code")
  countryCode String      @map("country_code") @db.Char(2)
  phone       String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
  @@map("order_addresses")
}

/// Every transition an order makes, starting with its creation (`from_status`
/// null). plan.md: "every transition writes to order_status_history".
model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actor      String
  note       String?
  changedAt  DateTime     @default(now()) @map("changed_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

/// A shopper with an account (plan.md's `customers`).
///
/// Only what the register form writes: an email and a password hash. plan.md's
/// `first_name`, `last_name`, `preferred_currency` and `email_verified_at`
/// arrive with the screens that write them — account details, the currency
/// preference, and the verification email — by the rule at the top of this
/// file. `locale` is here because the form knows it: it is the language the
/// account was opened in, which is what any future email should be written in.
///
/// `email` is stored lower-cased and trimmed by `apps/web/lib/account/` rather
/// than as `citext`, so the unique index is what makes two spellings of one
/// address one account, with no extension to install.
///
/// A different table from any admin identity, always (plan.md, decision 6).
model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  locale       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions  CustomerSession[]
  orders    Order[]
  addresses CustomerAddress[]

  @@map("customers")
}

/// A signed-in browser (plan.md's `sessions`).
///
/// The column holds the SHA-256 of the token in the `account_session` cookie,
/// the rule the cart and the admin follow: a leaked row is nothing anyone can
/// replay. plan.md's `ip` and `user_agent` are left out until something shows
/// a customer their sessions — a column of personal data nothing reads is a
/// liability, not a feature.
///
/// Expired rows are treated as absent on read and removed on sign-in; nothing
/// else sweeps them yet.
model CustomerSession {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("sessions")
}

/// A customer's saved address (plan.md's `addresses`): one billing and one
/// shipping, which is what My account → Addresses edits and what the checkout
/// starts its boxes from.
///
/// The order's columns rather than plan.md's single `name`, so an address
/// goes from the book to the checkout form to `order_addresses` without being
/// split or joined anywhere. An order never points here — it copies (decision
/// 4) — so editing an address changes no order already placed.
model CustomerAddress {
  id          String      @id @default(cuid())
  customerId  String      @map("customer_id")
  kind        AddressKind
  firstName   String      @map("first_name")
  lastName    String      @map("last_name")
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String      @map("postal_code")
  countryCode String      @map("country_code") @db.Char(2)
  phone       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, kind])
  @@map("addresses")
}

enum CouponType {
  fixed_amount
  percentage
}

/// A discount code, as the admin's create-coupon screen writes it.
///
/// `amount` is read by `type`: money in `currency` (the shop's) for
/// `fixed_amount`, and a percentage from 0 to 100 for `percentage`, when
/// `currency` is null. `code` is stored upper-cased, so the unique index is
/// what makes "save10" and "SAVE10" one coupon.
///
/// `applies_to_all_products` rather than "no rows in coupon_products means
/// all": an empty selection and "everything" are two different decisions, and
/// a coupon whose last product was deleted must not quietly start applying to
/// the whole catalogue.
///
/// Redeemed at the checkout (`couponDiscount` in `@my-ecommerce/shared`); an
/// order keeps the code it used in `orders.coupon_code`.
model Coupon {
  id                   String     @id @default(cuid())
  code                 String     @unique
  type                 CouponType
  amount               Decimal    @db.Decimal(10, 2)
  currency             String?    @db.Char(3)
  appliesToAllProducts Boolean    @map("applies_to_all_products")
  expiresAt            DateTime   @map("expires_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  products CouponProduct[]

  @@map("coupons")
}

/// The products a coupon applies to, when it does not apply to all of them.
model CouponProduct {
  couponId  String @map("coupon_id")
  productId String @map("product_id")

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
  @@map("coupon_products")
}

/// A message sent from the storefront's Contact page.
///
/// Kept rather than mailed: there is no mail yet, and a row is what an inbox
/// in the admin can later read. `locale` is the language the sender wrote from,
/// so a reply can be written in it. `handledAt` is null until someone answers.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  locale    String
  createdAt DateTime  @default(now()) @map("created_at")
  handledAt DateTime? @map("handled_at")

  @@index([createdAt])
  @@map("contact_messages")
}

/// How the shop can be reached — the admin's Contact → Info screen, read by
/// the storefront's "Get in Touch" column and footer.
///
/// One row, always `id = 1`: there is one shop. The migration that creates the
/// table writes it, so a read never has to invent defaults. A null field is one
/// the storefront leaves out.
model StoreContact {
  id           Int      @id @default(1)
  phone        String?
  email        String?
  whatsapp     String?
  address      String?
  facebookUrl  String?  @map("facebook_url")
  instagramUrl String?  @map("instagram_url")
  youtubeUrl   String?  @map("youtube_url")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("store_contact")
}

/// The storefront's FAQ page: one markdown description per language.
///
/// English is what the admin's Contact → FAQ screen writes; the other four are
/// written by the translation pass after a save. `autoTranslated` is the rule
/// every `*_translations` table keeps: a row the machine wrote may be
/// refreshed, a row a person wrote never is.
model FaqTranslation {
  locale         String   @id
  description    String
  autoTranslated Boolean  @default(false) @map("auto_translated")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("faq_translations")
}

/// The storefront's About page: one markdown description per language — the
/// FAQ's arrangement, for its reasons. English is what the admin's
/// Contact → About screen writes; the translation pass writes the rest. The
/// page's images are `media` rows with `about_page` set.
model AboutTranslation {
  locale         String   @id
  description    String
  autoTranslated Boolean  @default(false) @map("auto_translated")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("about_translations")
}

enum AdminRole {
  owner
  staff
}

/// An admin account (plan.md's `admin_users`), as the admin's User → Create
/// user screen writes it. Not a customer, and never joined to one (plan.md,
/// decision 6).
///
/// `name` rather than plan.md's `email`, for the reason `AdminLoginSchema`
/// gives. Names compare case-insensitively at sign-in, so the repository
/// refuses a name that differs from an existing one only in case; the unique
/// index is the backstop for two saves racing.
///
/// The two dev accounts in `lib/mock/admin-users.ts` are not rows: outside a
/// production build they are read alongside this table.
model AdminUser {
  id           String    @id @default(cuid())
  name         String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(staff)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}
